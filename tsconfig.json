{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker", "WebWorker.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "examples/**/*.ts",
    "generated/**/*.ts",
    "generated/**/*.d.ts"
  ]
}
